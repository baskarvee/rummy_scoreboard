rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the current user the host of this game?
    function isHost(gameId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/games/$(gameId)).data.hostUserId == request.auth.uid;
    }

    match /games/{gameId} {
      // Any signed-in user can read (needed for join-by-code lookup)
      allow read: if request.auth != null;

      // Only the creator (host) can create — hostUserId must match their uid
      allow create: if request.auth != null
                    && request.resource.data.hostUserId == request.auth.uid;

      // Only the host can update or delete the game document
      allow update, delete: if request.auth != null
                            && resource.data.hostUserId == request.auth.uid;

      match /players/{playerId} {
        allow read: if request.auth != null;

        // Allow create if:
        //   (a) the signed-in user is the host of the game, OR
        //   (b) the player being added has userId == the signed-in user (self-join)
        //   (c) the player is a guest (no userId) — host is adding someone without a phone
        allow create: if request.auth != null
                      && (
                        isHost(gameId)
                        || request.resource.data.userId == request.auth.uid
                        || request.resource.data.isGuest == true
                      );

        allow update, delete: if isHost(gameId);
      }

      match /rounds/{roundId} {
        allow read: if request.auth != null;

        // Allow create (new round) if signed-in user is the host
        allow create: if isHost(gameId);

        // Allow update if host OR the round winner (for editing their own round)
        allow update: if isHost(gameId)
                      || (request.auth != null
                          && resource.data.winnerPlayerId == request.auth.uid);

        allow delete: if isHost(gameId);
      }
    }
  }
}
